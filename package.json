{
  "name": "airo-virtual-desk-simulator",
  "version": "0.1.0",
  "description": "3D virtual standing desk simulator and laptop end-to-end simulation of the Airo retrofit controller",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "firmware:build": "cmake -S firmware -B firmware/build -DCMAKE_BUILD_TYPE=Release && cmake --build firmware/build -j",
    "firmware:test": "npm run firmware:build && ctest --test-dir firmware/build --output-on-failure",
    "airo": "npm run firmware:build && ./firmware/build/airo-host",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "sim": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "license": "UNLICENSED"
}
